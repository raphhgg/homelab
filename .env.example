# Basic settings
PUID=1000
PGID=1000
UMASK=002
TZ=Europe/Brussels

# Paths
DOCKER_PATH=/volume2/docker/appdata
MEDIA_PATH=/volume2/media

# Plex
PLEX_CLAIM=claim-your_plex_claim_token_here

# Database passwords (generate secure ones)
MYSQL_ROOT_PASSWORD=your_secure_mysql_password
POSTGRES_PASSWORD=your_secure_postgres_password

# API Keys (get these from your applications)
SONARR_API_KEY=your_sonarr_api_key_here
RADARR_API_KEY=your_radarr_api_key_here
PROWLARR_API_KEY=your_prowlarr_api_key_here
BAZARR_API_KEY=your_bazarr_api_key_here

# Notification webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_url
SLACK_WEBHOOK=https://hooks.slack.com/services/your_webhook_url

# Optional: Custom networks
NETWORK_SUBNET=172.20.0.0/16
