TZ=TZ
DOCKER_APPDATA_PATH=DOCKER_APPDATA_PATH
GOTIFY_HOST=gotify.your_domain

# Gotify initial admin credentials (change immediately after first login)
GOTIFY_DEFAULT_USER=admin
GOTIFY_DEFAULT_PASS=your_secure_password_here

# iGotify iOS Push Notifications (Local Instance mode)
# Required: Gotify must be accessible via a PUBLIC URL for iOS push to work
#
# 1. GOTIFY_PUBLIC_URL: Your public Gotify URL (e.g., https://gotify.yourdomain.com)
# 2. GOTIFY_CLIENT_TOKEN: Create in Gotify UI > Clients > Create Client
# 3. SECNTFY_TOKEN: Get from iGotify iOS app after device registration (starts with NTFY-DEVICE-)
#
# Leave all empty if using External Instance mode (both Gotify & iGotify publicly accessible)
# GOTIFY_PUBLIC_URL=
# GOTIFY_CLIENT_TOKEN=
# SECNTFY_TOKEN=

GOTIFY_CLIENT_TOKEN=your_gotify_client_token
PUSHOVER_USERKEY=your_pushover_user_key

# Pushtify - Pushover token mapping
# Default token used for Gotify apps without a specific Pushover token
PUSHOVER_DEFAULT_TOKEN=

# Per-app Pushover tokens (create apps at https://pushover.net/apps)
# Format: <GOTIFY_APP_NAME>_PUSHOVER_TOKEN=<pushover_app_token>
UPTIME_KUMA_PUSHOVER_TOKEN=
WATCHTOWER_PUSHOVER_TOKEN=
SONARR_PUSHOVER_TOKEN=
RADARR_PUSHOVER_TOKEN=
PROWLARR_PUSHOVER_TOKEN=
BAZARR_PUSHOVER_TOKEN=
TAUTULLI_PUSHOVER_TOKEN=
JELLYSEERR_PUSHOVER_TOKEN=
KOMETA_PUSHOVER_TOKEN=
PLEX_PUSHOVER_TOKEN=
AUTOBRR_PUSHOVER_TOKEN=
QBITTORRENT_PUSHOVER_TOKEN=
SYNOLOGY_PUSHOVER_TOKEN=

# Gotify Middleware - Gotify app tokens for formatted notifications
# These are the Application tokens from Gotify (not Client tokens)
SONARR_GOTIFY_TOKEN=your_sonarr_gotify_app_token
RADARR_GOTIFY_TOKEN=your_radarr_gotify_app_token
AUTOBRR_GOTIFY_TOKEN=your_autobrr_gotify_app_token
UPTIME_KUMA_GOTIFY_TOKEN=your_uptime_kuma_gotify_app_token
