TZ=TZ
DOCKER_APPDATA_PATH=DOCKER_APPDATA_PATH

# Gotify initial admin credentials (change immediately after first login)
GOTIFY_DEFAULT_USER=admin
GOTIFY_DEFAULT_PASS=your_secure_password_here

# iGotify iOS Push Notifications (Local Instance mode)
# Required: Gotify must be accessible via a PUBLIC URL for iOS push to work
#
# 1. GOTIFY_PUBLIC_URL: Your public Gotify URL (e.g., https://gotify.yourdomain.com)
# 2. GOTIFY_CLIENT_TOKEN: Create in Gotify UI > Clients > Create Client
# 3. SECNTFY_TOKEN: Get from iGotify iOS app after device registration (starts with NTFY-DEVICE-)
#
# Leave all empty if using External Instance mode (both Gotify & iGotify publicly accessible)
# GOTIFY_PUBLIC_URL=
# GOTIFY_CLIENT_TOKEN=
# SECNTFY_TOKEN=

GOTIFY_CLIENT_TOKEN=your_gotify_client_token
PUSHOVER_USERKEY=your_gotify_client_token