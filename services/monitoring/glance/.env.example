TZ=TZ
GLANCE_HOST=dash.your_domain
F1_API_DNS_PRIMARY=192.168.1.1
F1_API_DNS_SECONDARY=1.1.1.1
# Used by widget configs for container status (sock-path)
DOCKER_HOST=tcp://glance-proxy:2375
AUTH_SECRET_KEY=auth_secret_key
AUTH_ADMIN_PASSWORD=auth_admin_password
UNIFI_CONSOLE_IP=console_url
UNIFI_API_KEY=api_token
PROXMOXVE_URL=proxmoxve_url
PROXMOXVE_KEY=proxmoxve_api_token
UPTIME_KUMA_URL=uptime_kuma_url
UPTIME_KUMA_STATUS_SLUG=status_page_slug
SONARR_API_URL=sonarr_api_url
SONARR_URL=sonarr_url
SONARR_KEY=sonarr_api_key
RADARR_API_URL=radarr_api_url
RADARR_URL=radarr_url
RADARR_KEY=radarr_api_key
PROWLARR_API_URL=prowlarr_api_url
PROWLARR_URL=prowlarr_url
PROWLARR_KEY=prowlarr_api_key
PROWLARR_COLLAPSE_AFTER=5

# qBittorrent
QBITTORRENT_MAIN_IP=ip:port
QBITTORRENT_CROSS_IP=ip:port
QBITTORRENT_BRR_IP=ip:port

# Tautulli
TAUTULLI_IP=tautulli_ip
TAUTULLI_PORT=tautulli_port
TAUTULLI_BASE_URL=https://tautulli-internal.your_domain
TAUTULLI_API_KEY=tautulli_api_key
PLEX_SERVER_ID=plex_server_id

# F1 API image proxy (for browser-loaded SVG map in widgets)
F1_API_BASE_URL=https://dash.your_domain/_internal/f1-api
F1_TRACK_COLOUR=#8aaef4

# Plex
PLEX_URL=plex_url
PLEX_TOKEN=plex_token

# Weather
WEATHER_LOCATION=location

# Air Quality
AIR_QUALITY_TOKEN=token
LON=lon
LAT=lat

# Proxmox
PROXMOXVE_URL=your_proxmox_url
PROXMOXVE_KEY=your_proxmox_api_key

# AdGuard
ADGUARD_PASSWORD=your_adguard_password

# Linkwarden
LINKWARDEN_HOST=links.your_domain
LINKWARDEN_API_KEY=linkwarden_api_key
