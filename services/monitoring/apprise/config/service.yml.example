# Service-specific Apprise configuration template
# Copy and rename to match your service (e.g., backup.yml, monitoring.yml)
# Endpoint: http://localhost:8089/notify/{filename-without-extension}

version: 1

asset:
  app_id: "[Service Name] Notification Title"
  app_desc: "#category #tags"
  app_url: http://10.10.2.2:port/path
  image_url_logo: https://path.to/footer-logo.png
  image_url_mask: https://path.to/avatar-logo.png

urls:
  - discord://BotName@WEBHOOK_ID/WEBHOOK_TOKEN?format=markdown&footer=yes:
    - tag: service-name

# ============================================================================
# Testing
# ============================================================================
# Direct Apprise (no middleware):
# curl -X POST http://localhost:8089/notify/service-name -H "Content-Type: application/json" -d '{"title":"Test","body":"Test message"}'
#
# Via middleware (if applicable):
# curl -X POST http://apprise-middleware:5000/webhook/service-name -H "Content-Type: application/json" -d '{"title":"Test","message":"Test message"}'
