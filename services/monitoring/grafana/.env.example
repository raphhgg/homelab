PUID=PUID
PGID=PGID
TZ=TZ
DOCKER_APPDATA_PATH=DOCKER_APPDATA_PATH
GRAFANA_HOST=grafana.your_domain
GF_ADMIN_USER=admin
# Change this on first login
GF_ADMIN_PASSWORD=your_admin_password_here
GF_AUTH_GENERIC_OAUTH_ENABLED=false
GF_AUTH_GENERIC_OAUTH_NAME=Pocket ID
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=your_pocket_id_client_id
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=your_pocket_id_client_secret
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email groups
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://id.your_domain/authorize
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://id.your_domain/api/oidc/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://id.your_domain/api/oidc/userinfo
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'homelab-admins') && 'Admin' || 'Viewer'
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true

# Cloudflare Analytics (used by provisioned Infinity datasource)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
