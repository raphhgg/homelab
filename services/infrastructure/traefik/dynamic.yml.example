http:
  routers:
    adguard:
      rule: "Host(`adguard.raphh.me`)"
      entryPoints:
        - websecure
      middlewares:
        - allow-admin-apps
      service: adguard-service
      tls:
        certResolver: cloudflare

    traefik-dashboard:
      rule: "Host(`traefik.raphh.me`)"
      entryPoints:
        - websecure
      middlewares:
        - allow-admin-apps
        - dashboard-auth
      service: api@internal
      tls:
        certResolver: cloudflare

  services:
    adguard-service:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.10.2.101:80"

  middlewares:
    allow-admin-apps:
      ipAllowList:
        sourceRange:
          - "10.10.1.0/24"
          - "10.10.2.0/24"
          - "127.0.0.1/32"

    allow-default-apps:
      ipAllowList:
        sourceRange:
          - "10.10.1.0/24"
          - "10.10.2.0/24"
          - "127.0.0.1/32"

    allow-iot-enabled-apps:
      ipAllowList:
        sourceRange:
          - "10.10.1.0/24"
          - "10.10.2.0/24"
          - "10.10.3.0/24"
          - "127.0.0.1/32"

    dashboard-auth:
      basicAuth:
        users:
          - "admin:REPLACE_WITH_HTPASSWD_HASH"
