RADARR_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_QUALITY_PROFILE=your_radarr_quality_profile_name
RADARR_ROOT_FOLDER=your_radarr_root_folder_path
RADARR_MONITORED=true
RADARR_SEARCH_ON_ADD=true
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key_here
SONARR_QUALITY_PROFILE=your_sonarr_quality_profile_name
SONARR_ROOT_FOLDER=your_sonarr_root_folder_path
SONARR_MONITOR=all
SONARR_SEARCH_ON_ADD=true
# At least 32 characters; agents send it as "Authorization: Bearer <token>"
MCP_TOKEN=your_long_random_token_here
# Host headers the server answers to: the VM's LAN name and IP, and its Tailscale IP
MCP_ALLOWED_HOSTS=your_hostnames_here
