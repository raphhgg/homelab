# Autopulse Configuration Template
# Copy this file to: ${DOCKER_APPDATA_PATH}/autopulse/config.yaml
# Documentation: https://autopulse.dancodes.online/autopulse/

app:
  hostname: 0.0.0.0
  port: 2875
  database_url: sqlite:///app/data/autopulse.db

auth:
  # Change these default credentials!
  username: admin
  password: password

opts:
  check_path: true
  max_retries: 5

triggers:
  sonarr:
    type: sonarr
    # Optional: Path rewriting if needed
    # rewrite:
    #   from: /downloads/tv
    #   to: /data/medias/tv

  radarr:
    type: radarr
    # Optional: Path rewriting if needed
    # rewrite:
    #   from: /downloads/movies
    #   to: /data/medias/movies

targets:
  plex:
    type: plex
    url: http://localhost:32400
    # Get your Plex token from: Settings -> Network -> Show Advanced -> "X-Plex-Token"
    # Or visit: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
    token: YOUR_PLEX_TOKEN_HERE

# Optional: Webhooks for notifications
# webhooks:
#   discord:
#     type: discord
#     url: https://discord.com/api/webhooks/...

# Webhook endpoints for Sonarr and Radarr:
# Sonarr: http://autopulse:2875/trigger/sonarr
# Radarr: http://autopulse:2875/trigger/radarr
