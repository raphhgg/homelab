PUID=PUID
PGID=PGID
TZ=TZ
DOCKER_APPDATA_PATH=DOCKER_APPDATA_PATH
CHAT_HOST=chat.your_domain

OLLAMA_BASE_URL=http://your-ubuntu-server-ip:11434
OPENWEBUI_OAUTH_ENABLED=false
